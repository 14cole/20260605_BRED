        self.angle_f_step_var = StringVar("0.1")
        self.angle_start_var = StringVar("0.0")
        self.angle_stop_var = StringVar("80.0")
        self.angle_step_var = StringVar("1.0")
        self.wave_pol_var = StringVar("HH")
